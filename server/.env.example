# Blink Payments API credentials (from the BlinkPay Merchant Portal)
# https://merchants.blinkpay.co.nz/settings/api
#
# IMPORTANT: You must also add blinkpaydemo://callback (or your
# APP_REDIRECT_URI below) as a redirect URI in the Merchant Portal under
# Settings > API. This server sends it in every consent request so Blink
# Payments knows where to return the customer after bank authorisation.
BLINKPAY_API_URL=sandbox.debit.blinkpay.co.nz
BLINKPAY_CLIENT_ID=<your_client_id>
BLINKPAY_CLIENT_SECRET=<your_client_secret>

# Static API key for app-to-server authentication.
# Generate a random key, e.g.: openssl rand -hex 32
#
# DEMO ONLY: In production, use proper authentication (OAuth2, JWT, etc.)
# This key demonstrates the *pattern* of securing the connection between
# your mobile app and your backend server.
APP_API_KEY=<generate_a_random_key>

# Server configuration (optional)
SERVER_PORT=4567

# Price of the demo product. The server prices every order from this, so the
# app cannot choose what it is charged. run.sh passes it to the app for display.
UNIT_PRICE=1.00

# Where the customer returns after the bank. Must match a redirect URI
# registered in the Merchant Portal; defaults to blinkpaydemo://callback.
# APP_REDIRECT_URI=blinkpaydemo://callback
